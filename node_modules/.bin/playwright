#!/usr/bin/env node
const { spawnSync } = require('child_process');
const path = require('path');

const args = process.argv.slice(2);
if (args[0] !== 'test') {
  console.error('僅支援 playwright test。');
  process.exit(1);
}

const runnerPath = path.join(__dirname, '..', '..', 'scripts', 'playwright-runner.js');
const result = spawnSync('node', [runnerPath], { stdio: 'inherit', env: process.env });
process.exit(result.status === null ? 1 : result.status);
